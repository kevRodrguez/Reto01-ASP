@model Producto

@{
    ViewData["Title"] = "Detalle del Producto";
}

<h1>Detalle del Producto</h1>

<p><strong>Id:</strong> @Model.Id</p>
<p><strong>Producto:</strong> @Model.Nombre</p>
<p><strong>Descripción:</strong> @Model.Descripcion</p>
<p><strong>Precio:</strong> @Model.Precio</p>
<p><strong>Stock:</strong> @Model.Stock</p>
<p><strong>Categoría:</strong> @Model.Categoria</p>

<a asp-controller="Productos" asp-action="Index">Volver al catálogo</a>
