@model List<Producto>

@{
    ViewData["Title"] = ViewData["Titulo"];
}

<h1>@ViewData["Titulo"]</h1>
<p>Tienda: @ViewBag.NombreTienda</p>
<p>Total de productos: @ViewBag.CantidadProductos</p>

<table>
  <thead>
    <tr><th>Producto</th><th>Descripción</th><th>Precio</th><th>Stock</th></tr>
  </thead>
  <tbody>
    @foreach (var producto in Model)
    {
      <tr>
        <td>@producto.Nombre</td>
        <td>@producto.Descripcion</td>
        <td>@producto.Precio</td>
        <td>@producto.Stock</td>
      </tr>
    }
  </tbody>
</table>
