@model CatalogoViewModel

@{
    ViewData["Title"] = ViewData["Titulo"];
}

<div class="catalog-header mb-4">
    <h1 class="catalog-title">@ViewData["Titulo"]</h1>
    <p class="catalog-subtitle">Explora nuestro inventario y consulta el detalle de cada producto.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card catalog-card shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title mb-3">Información de la tienda</h2>
                <p class="mb-1"><strong>@Model.Tienda.Nombre</strong></p>
                <p class="text-muted mb-2">@Model.Tienda.Descripcion</p>
                <ul class="list-unstyled store-info mb-0">
                    <li><span>Ubicación:</span> @Model.Tienda.Ubicacion</li>
                    <li><span>Email:</span> @Model.Tienda.Email</li>
                    <li><span>Teléfono:</span> @Model.Tienda.Telefono</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card catalog-card catalog-summary shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title mb-3">Resumen</h2>
                <p class="summary-value mb-1">@Model.CantidadProductos</p>
                <p class="text-muted mb-0">productos disponibles en catálogo</p>
            </div>
        </div>
    </div>
</div>

<div class="card catalog-card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Listado de productos</h2>
            <span class="badge text-bg-primary">Total: @Model.CantidadProductos</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover catalog-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in Model.Productos)
                    {
                        <tr>
                            <td class="fw-semibold">@producto.Nombre</td>
                            <td>@producto.Descripcion</td>
                            <td><span class="badge text-bg-light">@producto.Categoria.Nombre</span></td>
                            <td>$@producto.Precio.ToString("N2")</td>
                            <td>
                                @if (producto.Stock > 10)
                                {
                                    <span class="badge text-bg-success">@producto.Stock</span>
                                }
                                else if (producto.Stock > 0)
                                {
                                    <span class="badge text-bg-warning">@producto.Stock</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">@producto.Stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Productos"
                                   asp-action="Details"
                                   asp-route-id="@producto.Id">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
